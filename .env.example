# Copy to .env and edit. Every setting in amin/config.py can be overridden.
AMIN_PROVIDER=auto                # auto (Amin's own model, else Ollama) | ollama | mlx | echo
AMIN_MLX_MODEL=edge-2-q8          # E38; amin-3 is the previous default
AMIN_OLLAMA_HOST=http://127.0.0.1:11434
AMIN_ANSWER_MODEL=qwen3.6:27b
AMIN_UTILITY_MODEL=qwen3:8b
AMIN_EMBED_MODEL=nomic-embed-text
AMIN_VERIFIER=llm                 # llm | lexical | off
AMIN_EVIDENCE_FLOOR=0.45          # see docs/EXPERIMENTS.md E3
AMIN_TOP_K_FINAL=6
AMIN_CHUNK_CHARS=900
