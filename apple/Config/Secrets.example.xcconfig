// Copy to Secrets.xcconfig (gitignored) and fill in. See backend/SETUP.md.
// The anon key and RevenueCat public SDK key are designed to ship in apps;
// never put the Supabase service-role key or the webhook secret here.
AMIN_SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
AMIN_SUPABASE_ANON_KEY = eyJ...
AMIN_REVENUECAT_KEY = appl_...
AMIN_HF_MODEL_ORG = your-hf-org
